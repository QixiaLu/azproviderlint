package azr008

import "fmt"

type NetworkACLs struct {
	Name string
}

type NetworkRuleSet struct {
	Rules []string
}

type ACLList []NetworkACLs

func validate(input *NetworkRuleSet) error {
	return nil
}

// Should NOT be flagged: returns an empty slice on the nil-input guard
func flattenReturnsEmptySlice(input *NetworkRuleSet) []NetworkACLs {
	if input == nil {
		return []NetworkACLs{}
	}
	return []NetworkACLs{{Name: "test"}}
}

// Should NOT be flagged: expand functions are allowed to return nil
func expandCanReturnNil(input []NetworkACLs) *NetworkRuleSet {
	if len(input) == 0 {
		return nil
	}
	return &NetworkRuleSet{}
}

// Should NOT be flagged: the result is not a slice
func flattenToString(input *NetworkRuleSet) string {
	if input == nil {
		return ""
	}
	return "result"
}

// Should NOT be flagged: every slice position returns an empty slice
func flattenMultipleSlicesValid(input *NetworkRuleSet) ([]NetworkACLs, []any, error) {
	if input == nil {
		return []NetworkACLs{}, []any{}, nil
	}
	return []NetworkACLs{{Name: "test"}}, []any{"a"}, nil
}

// Should be flagged: returns nil for a slice result
func flattenReturnsNil(input *NetworkRuleSet) []NetworkACLs {
	if input == nil {
		return []NetworkACLs{} // want `flatten function "flattenReturnsNil" should return an empty slice instead of nil`
	}
	return []NetworkACLs{{Name: "test"}}
}

// Should be flagged: returns nil in the slice position of a multi-value return with a nil error
func flattenWithErrorNil(input *NetworkRuleSet) ([]NetworkACLs, error) {
	if input == nil {
		return []NetworkACLs{}, nil // want `flatten function "flattenWithErrorNil" should return an empty slice instead of nil`
	}
	return []NetworkACLs{{Name: "test"}}, nil
}

// Should be flagged: one of several slice positions returns nil with a nil error
func flattenMultipleSlicesOneNil(input *NetworkRuleSet) ([]NetworkACLs, []any, error) {
	if input == nil {
		return []NetworkACLs{}, []any{}, nil // want `flatten function "flattenMultipleSlicesOneNil" should return an empty slice instead of nil`
	}
	return []NetworkACLs{{Name: "test"}}, []any{"a"}, nil
}

// Should NOT be flagged on the error path (return nil, err); only the nil-input branch is flagged
func flattenWithErrorHandling(input *NetworkRuleSet) ([]NetworkACLs, error) {
	if input == nil {
		return []NetworkACLs{}, nil // want `flatten function "flattenWithErrorHandling" should return an empty slice instead of nil`
	}
	if err := validate(input); err != nil {
		return nil, err
	}
	return []NetworkACLs{{Name: "test"}}, nil
}

// Should NOT be flagged: the nil-input branch itself returns an error
func flattenNilInputReturnsError(input *NetworkRuleSet) ([]NetworkACLs, error) {
	if input == nil {
		return nil, fmt.Errorf("input is nil")
	}
	return []NetworkACLs{{Name: "test"}}, nil
}

// Should NOT be flagged: error path in a three-value return (return nil, nil, err)
func flattenThreeWithError(input *NetworkRuleSet) ([]NetworkACLs, []any, error) {
	if err := validate(input); err != nil {
		return nil, nil, err
	}
	return []NetworkACLs{{Name: "test"}}, []any{"a"}, nil
}

// Should be flagged: the flatten prefix match is case-insensitive
func FlattenUpperCase(input *NetworkRuleSet) []NetworkACLs {
	if input == nil {
		return []NetworkACLs{} // want `flatten function "FlattenUpperCase" should return an empty slice instead of nil`
	}
	return []NetworkACLs{{Name: "test"}}
}

// Should be flagged: a multi-name slice field expands to every return position it covers
func flattenMultiName(input *NetworkRuleSet) (a, b []NetworkACLs, err error) {
	if input == nil {
		return []NetworkACLs{}, []NetworkACLs{}, nil // want `flatten function "flattenMultiName" should return an empty slice instead of nil`
	}
	return []NetworkACLs{{Name: "test"}}, []NetworkACLs{{Name: "test2"}}, nil
}

// Should be flagged: named slice types are detected via the type checker, not the syntax
func flattenNamedSliceType(input *NetworkRuleSet) ACLList {
	if input == nil {
		return ACLList{} // want `flatten function "flattenNamedSliceType" should return an empty slice instead of nil`
	}
	return ACLList{{Name: "test"}}
}

// Should NOT be flagged: a nil return inside a closure answers to the closure, not the flatten function
func flattenWithClosure(input *NetworkRuleSet) []NetworkACLs {
	build := func() []string {
		return nil
	}
	_ = build
	if input == nil {
		return []NetworkACLs{}
	}
	return []NetworkACLs{{Name: "test"}}
}

// Should be flagged: a naked return whose named slice result has not been assigned yet
// returns a nil slice; the later naked return, after the assignment, is fine.
func flattenNakedReturn(input *NetworkRuleSet) (ret []NetworkACLs) {
	if input == nil {
		return []NetworkACLs{} // want `flatten function "flattenNakedReturn" should return an empty slice instead of nil`
	}
	ret = []NetworkACLs{{Name: "test"}}
	return
}

// Should be flagged: a conversion of nil is still a nil slice, and a nil error
// (`error(nil)`) does not make the return an error path
func flattenConvertedNil(input *NetworkRuleSet) ([]NetworkACLs, error) {
	if input == nil {
		return []NetworkACLs{}, error(nil) // want `flatten function "flattenConvertedNil" should return an empty slice instead of nil`
	}
	return []NetworkACLs{}, nil
}

// Should be flagged: a nil map result is the same disease as a nil slice.
func flattenTagsMap(input *NetworkRuleSet) map[string]interface{} {
	if input == nil {
		return map[string]interface{}{} // want `flatten function "flattenTagsMap" should return an empty map instead of nil`
	}
	return map[string]interface{}{}
}

// Should NOT be flagged: a nil map pointer is a deliberate absent signal.
func flattenPointerMap(input *NetworkRuleSet) *map[string]interface{} {
	if input == nil {
		return nil
	}
	return &map[string]interface{}{}
}

// Should be flagged: both container positions are nil, message names both kinds.
func flattenMixedKinds(input *NetworkRuleSet) ([]NetworkACLs, map[string]string) {
	if input == nil {
		return []NetworkACLs{}, map[string]string{} // want `flatten function "flattenMixedKinds" should return an empty slice/map instead of nil`
	}
	return []NetworkACLs{}, map[string]string{}
}

// Should be flagged: a naked return on the nil-input guard with an unassigned error position
// is not an error path; the fix keeps the error name in place.
func flattenNakedWithError(input *NetworkRuleSet) (ret []NetworkACLs, err error) {
	if input == nil {
		return []NetworkACLs{}, err // want `flatten function "flattenNakedWithError" should return an empty slice instead of nil`
	}
	ret = []NetworkACLs{{Name: "test"}}
	return
}

// Should NOT be flagged: the error was assigned before the naked return, so it is an error path.
func flattenNakedErrorPath(input *NetworkRuleSet, fail func() error) (ret []NetworkACLs, err error) {
	err = fail()
	if err != nil {
		return
	}
	ret = []NetworkACLs{{Name: "test"}}
	return
}

// Should be flagged: the returned variable is provably still nil at the guard; the later
// return, after the append, is fine.
func flattenVarStillNil(input *NetworkRuleSet) []NetworkACLs {
	var out []NetworkACLs
	if input == nil {
		return []NetworkACLs{} // want `flatten function "flattenVarStillNil" should return an empty slice instead of nil`
	}
	out = append(out, NetworkACLs{Name: "test"})
	return out
}

// Should be flagged: the variable's only use is the return, so the fix also deletes the
// declaration line.
func flattenVarOnlyUse(input *NetworkRuleSet) []NetworkACLs {
	return []NetworkACLs{} // want `flatten function "flattenVarOnlyUse" should return an empty slice instead of nil`
}

// Should be flagged without a fix: the declaration also declares another variable, so it
// cannot be deleted safely.
func flattenVarSharedDecl(input *NetworkRuleSet) []NetworkACLs {
	var out, other []NetworkACLs
	_ = other
	return out // want `flatten function "flattenVarSharedDecl" should return an empty slice instead of nil`
}

// Should be flagged: a declared-but-nil error value does not make this an error path.
func flattenNilErrVar(input *NetworkRuleSet) ([]NetworkACLs, error) {
	var noErr error
	if input == nil {
		return []NetworkACLs{}, noErr // want `flatten function "flattenNilErrVar" should return an empty slice instead of nil`
	}
	return []NetworkACLs{}, noErr
}

// Should NOT be flagged: a parameter is caller-supplied, not provably nil.
func flattenPassthrough(acls []NetworkACLs) []NetworkACLs {
	return acls
}

// Should NOT be flagged: the variable's address is taken, so nothing is provable.
func flattenAddressTaken(input *NetworkRuleSet, fill func(*[]NetworkACLs)) []NetworkACLs {
	var out []NetworkACLs
	fill(&out)
	return out
}

